# --- SatNOGS -------------------------------------------------------------
# Network API token: https://network.satnogs.org/users/edit/  ("API Key").
# NOTE: SatNOGS Network and SatNOGS DB issue *separate* tokens. A DB token is
# rejected by the Network API with 401 "Invalid token". Reads work without a
# token but are throttled to 60 requests/hour instead of 240/hour.
SATNOGS_API_TOKEN=
SATNOGS_NETWORK_URL=https://network.satnogs.org

# Satellite to ingest (stand-in until PVDX has a NORAD ID).
NORAD_CAT_ID=62394

# --- Ingest --------------------------------------------------------------
# Earliest observation start to ingest (ISO-8601, UTC). Every sweep starts at
# max(INGEST_START, watermark - overlap), so in practice only the first sweep is
# affected. Set it a few days back: an active satellite yields ~50 observations and
# thousands of frame files per day, and anonymous paging is one page per minute.
INGEST_START=2026-09-24T00:00:00Z
# Re-scan window behind the watermark on each sweep (observations are vetted
# "good" shortly after they end, but frames can be uploaded late).
INGEST_OVERLAP_HOURS=48
# SQLite state database (raw frames, decoded fields and provenance live here).
STATE_DB=data/state.db
# Only "good" observations carry demodulated frames worth ingesting.
INGEST_STATUS=good
# Seconds between API list requests. Default is derived from the throttle
# (63 s anonymous, 15.8 s with a valid Network token); only lower it if SatNOGS says so.
#INGEST_MIN_INTERVAL=63

# --- Decode ---------------------------------------------------------------
# Decoder plugin name (see pvdx_ground/decode). "satnogs:<struct>" wraps a
# Kaitai struct from the satnogs-decoders package; "pvdx" is the stub.
DECODER=satnogs:crocube

# --- InfluxDB 2.x / Grafana (docker compose) -------------------------------
INFLUX_URL=http://localhost:8086
INFLUX_ORG=bse
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=change-me-local-dev-token
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-admin-password
GRAFANA_ADMIN_PASSWORD=admin

# --- Service (pvdx-serve: ingest + decode + HTTP API in one process) -------
# Bind address of the HTTP API. Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=8080
# Browser origins allowed to call the API directly (comma separated, or *).
API_CORS_ORIGINS=http://localhost:3000
# Shared secret the ground station must send as X-Ingest-Token on POST /ingest/frames.
# Empty = accept pushes from anyone (fine on a laptop, not on a public host).
INGEST_TOKEN=
# Seconds between SatNOGS sweeps and between decode passes (pushed frames are
# decoded immediately regardless of DECODE_POLL).
INGEST_POLL=600
DECODE_POLL=60
# GET /telemetry reports stale=true when the newest decoded frame is older than this (seconds).
TELEMETRY_STALE_AFTER=3600
# Extra names for decoded fields, alias=field, comma separated. The mission-control
# frontend reads battery, elevation, temperature, signal_rssi and uptime_seconds; map
# them to whatever the current decoder produces (CroCube example below, raw units:
# battery is mV, temperature is tenths of a degree).
TELEMETRY_ALIASES=battery=psu_battery,temperature=obc_temp_mcu,signal_rssi=uhf_act_rssi_raw,uptime_seconds=obc_uptime

# --- Redis (latest-values cache read by the web app backend) ---------------
# Empty = do not publish. docker compose starts a Redis on localhost:6379.
REDIS_URL=redis://localhost:6379/0
# Key prefix; the web app backend reads telemetry:<field>.
REDIS_KEY_PREFIX=telemetry:
# Seconds the published keys live; after that the web app shows "stale".
REDIS_TELEMETRY_TTL=3600

# --- pvdx-push (only on the ground station computer) -----------------------
# Base URL of the cloud service and the name this station reports.
PUSH_URL=http://localhost:8080
PUSH_STATION=BSE Providence
# Must equal INGEST_TOKEN on the service.
PUSH_TOKEN=
